+func radVisibility(ctx context.Context, home string, repoPath string) (string, error) {
+	inspect := exec.CommandContext(ctx, "rad", "inspect", "--identity")
+	inspect.Dir = repoPath
+	inspect.Env = radEnv(home)
+	out, err := inspect.Output()
+	if err != nil {
+		return "", fmt.Errorf("rad inspect --identity failed: %w", err)
+	}
+	var doc struct {
+		Visibility *struct {
+			Type string `json:"type"`
+		} `json:"visibility"`
+	}
+	if err := json.Unmarshal(out, &doc); err != nil {
+		return "", fmt.Errorf("cannot parse identity document: %w", err)
+	}
+	// the identity document omits visibility for public repositories
+	if doc.Visibility == nil {
+		return "public", nil
+	}
+	return doc.Visibility.Type, nil
+}
+
+// rad init --existing keeps the visibility of an existing identity, so a
+// repository made private on github would stay public on radicle
+func ensureVisibility(ctx context.Context, home string, repoPath string, private bool) error {
+	want := "public"
+	if private {
+		want = "private"
+	}
+	current, err := radVisibility(ctx, home, repoPath)
+	if err != nil {
+		return err
+	}
+	if current == want {
+		return nil
+	}
+	cmd := exec.CommandContext(ctx, "rad", "id", "update",
+		"--title", "Set visibility to "+want,
+		"--description", "Updated by radicle-mirror",
+		"--visibility", want)
+	cmd.Dir = repoPath
+	cmd.Env = radEnv(home)
+	var buf bytes.Buffer
+	cmd.Stdout = &buf
+	cmd.Stderr = &buf
+	if err := cmd.Run(); err != nil {
+		return fmt.Errorf("rad id update --visibility failed: %w, output: %s", err, buf.String())
+	}
+	current, err = radVisibility(ctx, home, repoPath)
+	if err != nil {
+		return err
+	}
+	if current != want {
+		return fmt.Errorf("identity visibility is %s after update, want %s", current, want)
+	}
+	slog.Info("updated visibility", "repo", repoPath, "visibility", want)
+	return nil
+}
+
 func isMissingIdentityError(output string) bool {
 	return strings.Contains(output, "missing identity document")
 }
