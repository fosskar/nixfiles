      {
        "uid": "ac9ecace6690ce",
        "title": "SMART device missing",
        "condition": "C",
        "data": [
          {
            "refId": "A",
            "relativeTimeRange": {
              "from": 300,
              "to": 0
            },
            "datasourceUid": "P4169E866C3094E38",
            "model": {
              "datasource": {
                "type": "prometheus",
                "uid": "P4169E866C3094E38"
              },
              "editorMode": "code",
              "exemplar": false,
              "expr": "count(count by(device) (last_over_time(smart_device_exit_status{host=\"nixbox\"}[15m])))",
              "instant": true,
              "interval": "",
              "intervalMs": 15000,
              "legendFormat": "devices",
              "maxDataPoints": 43200,
              "range": false,
              "refId": "A"
            }
          },
          {
            "refId": "C",
            "relativeTimeRange": {
              "from": 0,
              "to": 0
            },
            "datasourceUid": "__expr__",
            "model": {
              "conditions": [
                {
                  "evaluator": {
                    "params": [9],
                    "type": "lt"
                  },
                  "operator": {
                    "type": "and"
                  },
                  "query": {
                    "params": []
                  },
                  "reducer": {
                    "params": [],
                    "type": "last"
                  },
                  "type": "query"
                }
              ],
              "datasource": {
                "type": "__expr__",
                "uid": "__expr__"
              },
              "expression": "A",
              "intervalMs": 1000,
              "maxDataPoints": 43200,
              "refId": "C",
              "type": "threshold"
            }
          }
        ],
        "noDataState": "Alerting",
        "execErrState": "Alerting",
        "for": "1h",
        "annotations": {
          "description": "Fewer than nine nixbox SMART devices have reported during the previous 15 minutes for one hour. Sleeping disks still report smart_device_exit_status with power=\"STANDBY\", so they are not treated as missing."
        },
        "isPaused": false,
        "notification_settings": {
          "receiver": "matrix-alert-hook"
        }
      },
      {
        "uid": "2aa1d3c0e0d3d7",
