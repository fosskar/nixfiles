[
  {
    "orgId": 1,
    "name": "victoria-capacity",
    "folder": "Monitoring",
    "interval": "15m",
    "rules": [
      {
        "uid": "bfwbem7hr3im8d",
        "title": "Victoria storage space low",
        "condition": "C",
        "data": [
          {
            "refId": "A",
            "relativeTimeRange": {
              "from": 900,
              "to": 0
            },
            "datasourceUid": "P4169E866C3094E38",
            "model": {
              "datasource": {
                "type": "prometheus",
                "uid": "P4169E866C3094E38"
              },
              "editorMode": "code",
              "exemplar": false,
              "expr": "min by(machine, path, __name__) ({__name__=~\"vm_free_disk_space_bytes|vl_free_disk_space_bytes\"})",
              "instant": true,
              "interval": "",
              "intervalMs": 15000,
              "legendFormat": "{{__name__}} {{path}}",
              "maxDataPoints": 43200,
              "range": false,
              "refId": "A"
            }
          },
          {
            "refId": "C",
            "relativeTimeRange": {
              "from": 0,
              "to": 0
            },
            "datasourceUid": "__expr__",
            "model": {
              "conditions": [
                {
                  "evaluator": {
                    "params": [21474836480],
                    "type": "lt"
                  },
                  "operator": {
                    "type": "and"
                  },
                  "query": {
                    "params": []
                  },
                  "reducer": {
                    "params": [],
                    "type": "last"
                  },
                  "type": "query"
                }
              ],
              "datasource": {
                "type": "__expr__",
                "uid": "__expr__"
              },
              "expression": "A",
              "intervalMs": 1000,
              "maxDataPoints": 43200,
              "refId": "C",
              "type": "threshold"
            }
          }
        ],
        "noDataState": "Alerting",
        "execErrState": "Alerting",
        "for": "15m",
        "annotations": {
          "description": "VictoriaMetrics or VictoriaLogs reports less than 20 GiB of free storage for fifteen minutes."
        },
        "isPaused": false,
        "notification_settings": {
          "receiver": "matrix-alert-hook"
        }
      }
    ]
  },
  {
