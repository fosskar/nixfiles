         ->toContain('my-kitchen-display')
         ->toContain('slot2:my-kitchen-display');
 });
+
+test('playlist item mashup render replaces a failing plugin with an error tile', function (): void {
+    $user = User::factory()->create();
+    $device = Device::factory()->create(['user_id' => $user->id]);
+    $playlist = Playlist::factory()->create(['device_id' => $device->id]);
+
+    $working = Plugin::factory()->create([
+        'user_id' => $user->id,
+        'plugin_type' => 'recipe',
+        'markup_language' => 'liquid',
+        'render_markup' => 'working-plugin-content',
+    ]);
+    $broken = Plugin::factory()->create([
+        'user_id' => $user->id,
+        'name' => 'Broken Plugin',
+        'plugin_type' => 'recipe',
+        'markup_language' => 'blade',
+        'render_markup' => '<div>{{ $data[0]["invalid"] }}</div>',
+        'data_payload' => [],
+    ]);
+
+    $item = PlaylistItem::createMashup($playlist, '1Lx1R', [$working->id, $broken->id], 'Test Mashup', 1);
+
+    expect($item->render($device))
+        ->toContain('working-plugin-content')
+        ->toContain('Error on Broken Plugin');
+});
